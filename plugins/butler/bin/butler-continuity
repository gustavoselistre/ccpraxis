#!/bin/bash
# butler-continuity -- extensionless shim (Decision 47). All logic lives in
# ../scripts/butler-continuity.pl; this only locates it and exec's it.
if [ -z "${BASH_VERSION:-}" ]; then exec bash "$0" "$@"; fi

set -e

BIN_DIR=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
SCRIPT="$BIN_DIR/../scripts/butler-continuity.pl"

if [ ! -f "$SCRIPT" ]; then
  echo "butler-continuity: butler-continuity.pl not found at $SCRIPT" >&2
  exit 1
fi

exec perl "$SCRIPT" "$@"
